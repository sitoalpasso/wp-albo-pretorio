<?xml version="1.0"?>
<ruleset name="albo-pretorio-pa">
	<description>Standard di codifica del componente: WordPress Coding Standards.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Il repository usa il namespace, non i prefissi sui nomi di file. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="albo-pretorio-pa"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="AlboPretorioPa"/>
				<element value="albo_pretorio"/>
				<element value="ALBO_PRETORIO"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		L'avvio della suite gira da riga di comando prima che WordPress sia
		caricato: WP_Filesystem non esiste ancora e la diagnostica va su STDERR.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>/tests/bootstrap*\.php</exclude-pattern>
		<exclude-pattern>/tests/avvio-comune\.php</exclude-pattern>
	</rule>

	<!--
		Nei test valgono regole diverse, e non per comodita'. Eseguire un aggancio
		di WordPress e' cio' che una prova deve fare per osservare un avviso in
		bacheca, e il prefisso obbligatorio sui nomi degli agganci riguarda quelli
		che il componente dichiara, non quelli che una prova esegue. Le operazioni
		su file passano dalle funzioni di PHP perche' l'astrazione di WordPress
		sul filesystem, in un test, aggiunge un pezzo di infrastruttura da
		configurare senza rendere la prova piu' vera.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		Un avvio della suite definisce la costante della versione di interfaccia
		del componente comune prima che quel componente si carichi: e' il solo modo
		di far vedere alla guardia una versione diversa da quella reale, e la
		costante e' di quel componente, non nostra, quindi non porta il nostro
		prefisso.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/bootstrap-core-incompatibile\.php</exclude-pattern>
	</rule>
</ruleset>
