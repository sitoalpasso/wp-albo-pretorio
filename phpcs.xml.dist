<?xml version="1.0"?>
<ruleset name="albo-pretorio-pa">
	<description>Standard di codifica del componente: WordPress Coding Standards.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="4"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Il repository usa il namespace, non i prefissi sui nomi di file. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="albo-pretorio-pa"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="AlboPretorioPa"/>
				<element value="albo_pretorio"/>
				<element value="ALBO_PRETORIO"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!--
		L'avvio della suite gira da riga di comando prima che WordPress sia
		caricato: WP_Filesystem non esiste ancora e la diagnostica va su STDERR.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>/tests/bootstrap*\.php</exclude-pattern>
		<exclude-pattern>/tests/avvio-comune\.php</exclude-pattern>
	</rule>

	<!--
		Gli avvii della suite girano da riga di comando e definiscono funzioni
		globali che servono solo a loro: il prefisso obbligatorio sui nomi
		globali non si applica a codice che non arriva mai dentro WordPress.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
